{
    "name": "thesis/protobuf",
    "description": "A modern strictly typed full-featured serializer for Google's protocol buffers.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "thesis/endian": "^0.3.3"
    },
    "require-dev": {
        "ext-filter": "*",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^12.4.4",
        "symfony/var-dumper": "^6.4.15 || ^7.3.5",
        "thesis/protobuf-known-types": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Protobuf\\": "src/"
        },
        "files": [
            "src/constructors.php",
            "src/Internal/Buffer/buffer.php",
            "src/Internal/Wire/wire.php",
            "src/Reflection/Internal/numeric.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Conformance\\": "tests/conformance/generated/Conformance/",
            "ProtobufTestMessages\\": "tests/conformance/generated/ProtobufTestMessages/",
            "Thesis\\Protobuf\\": "tests/",
            "Thesis\\Protobuf\\Benchmarks\\": "benchmarks/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
